[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Dd]ebugPublic/
[Rr]eleases/
x64/
x86/
build/
bld/
[Ll]og/
[Ll]ogs/
artifacts/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Build & MSBuild
*.binlog
*.tlog
project.lock.json
project.fragment.lock.json

# .NET / NuGet
*.nupkg
*.snupkg
.packages/
packages/
*.nuget.props
*.nuget.targets

# Test results & coverage
[Tt]est[Rr]esult*/
TestResults/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# SQLite database & runtime data (generated by Migration.Run / Playground)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
pos.db

# Application-generated output (backups, exports, printing)
[Bb]ackup/
[Bb]ackups/
[Ee]xport/
[Ee]xports/
*.bak

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Misc
*.log
*.tmp
*.cache
